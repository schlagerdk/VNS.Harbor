.DS_Store

# Notes and scripts of your own, not part of the solution
misc/

# Local tools, such as make_release.sh, not part of the solution
.local/

# Python's caches
__pycache__/
*.pyc
.pytest_cache/

# The VNS.Harbor package's build output
nuget/bin/
nuget/obj/
nuget/artifacts/

# What the admin writes when it runs from a working copy (tests): never part of the code
admin/config.json
admin/audit.log
admin/sql-connections.json
admin/system-update.*
admin/static/vendor/
