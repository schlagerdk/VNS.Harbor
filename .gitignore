.DS_Store
misc/*

# Local tools, such as make_release.sh, not part of the solution
.local/

# Python compile cache
__pycache__/
*.pyc

# The admin's activity log is the server's own, and a run from the repository writes one beside the app
apache/solutionfiles/admin/app/audit.log
# The VNS.Harbor package's build output
nuget/bin/
nuget/obj/

# What the admin writes when it runs from a working copy (tests): never part of the code
admin/config.json
admin/audit.log
admin/sql-connections.json
admin/system-update.*
admin/static/vendor/
